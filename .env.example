# PostgreSQL Database URL (Neon, Supabase, Vercel Postgres, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth Secret (random 32+ character string)
NEXTAUTH_SECRET="super-secret-loan-crm-key-change-in-production-2026"

# NextAuth URL (optional on Vercel as it automatically uses VERCEL_URL)
NEXTAUTH_URL="https://your-app.vercel.app"
